<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1A7C4E20-0B31-4C7D-9E11-000000000001}</ProjectGuid>
    <RootNamespace>SP_01</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <PlatformToolset Condition="'$(Configuration)'=='Debug'">v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)$(ProjectName)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <!-- /Oi- отключает встраивание функций.

           Имя экспортируемой функции на Windows буквально «div»: в SP.def стоит
           алиас div = div_int, потому что MSVC объявляет div() как встроенную
           функцию в <intrinst.h>.

           Наша extern "C" int div(int, int) из SP.dll должна обрабатываться как
           обычная внешняя функция. Возвращаемый тип встроенной функции (div_t)
           имел бы значение только при встраивании, которое /Oi- выключает.
           Без этого компилятор даёт жёсткую ошибку C2169: «div»: подставляемая
           функция, определение невозможно. -->
      <IntrinsicFunctions>false</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <!-- Статическая линковка — в этом весь смысл задания 01.

       ProjectReference здесь работает в полную силу, в отличие от задания 02:
       даёт путь к SP.lib, задаёт порядок сборки и ЛИНКУЕТ библиотеку в exe.
       Из-за этого SP.dll попадает в таблицу импортов SP_01.exe — загрузчик
       Windows обязан найти её при старте, иначе 0xc0000135.

       Проверка: dumpbin /dependents SP_01.exe показывает SP.dll в списке. -->

  <!-- Копирование SP.dll рядом с exe.
       Без этого запуск падает с 0xc0000135 STATUS_DLL_NOT_FOUND: загрузчик
       Windows ищет DLL только в папке самого exe.

       $(MSBuildThisFileDirectory) — папка текущего .vcxproj с завершающим
       слэшем. Нужен вместо $(SolutionDir), потому что этот файл может быть
       собран и напрямую, без открытого решения.

       Condition на Exists означает: если DLL ещё нет, сборка не падает,
       а просто пропускает копирование. Ошибка всплывёт позже, при запуске. -->
  <ItemGroup>
    <ProjectReference Include="..\SP_lib\SP.vcxproj">
      <Project>{1A7C4E20-0B31-4C7D-9E11-000000000000}</Project>
    </ProjectReference>
  </ItemGroup>
  <!-- Put SP.dll next to SP_01.exe so the loader can resolve the static import. -->
  <Target Name="CopySPDllToOutDir" AfterTargets="Build">
    <ItemGroup>
      <SPDllSource Include="$(MSBuildThisFileDirectory)..\SP_lib\SP\$(Platform)\$(Configuration)\SP.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SPDllSource)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(SPDllSource.Identity)')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
