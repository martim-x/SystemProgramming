<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Копирование нативной SP.dll рядом со собранным exe.

       Зачем: NativeLibrary.Load("SP.dll") ищет файл рядом с exe, иначе бросает
       DllNotFoundException. В отличие от задания 05, здесь путь передаётся
       в коде явно, но загрузчик всё равно ищет в своём каталоге.

       Почему не через $(Platform): у C#-проектов $(Platform) равен AnyCPU,
       а не ARM64. Подставить ARM64 в путь можно только вручную, как здесь.

       Три кандидата проверяются по порядку, побеждает первый существующий.
       Условие '$(SPLibPath)' == '' в каждом следующем не даёт переписать уже
       найденный путь. Первый кандидат — фактический путь на этой машине. -->
  <PropertyGroup>
    <SPLibRelDir1>..\..\SP_lib\SP\ARM64\Release\SP.dll</SPLibRelDir1>
    <SPLibRelDir2>..\..\SP_lib\bin\ARM64\Release\SP.dll</SPLibRelDir2>
    <SPLibRelDir3>..\..\SP_lib\bin\Release\SP.dll</SPLibRelDir3>
  </PropertyGroup>

  <!-- AfterTargets="Build" — копирование произойдёт после сборки проекта,
       но до того, как Visual Studio его запустит. -->
  <Target Name="CopySPLib" AfterTargets="Build">
    <PropertyGroup>
      <SPLibPath Condition="'$(SPLibPath)' == '' And Exists('$(SPLibRelDir1)')">$(SPLibRelDir1)</SPLibPath>
      <SPLibPath Condition="'$(SPLibPath)' == '' And Exists('$(SPLibRelDir2)')">$(SPLibRelDir2)</SPLibPath>
      <SPLibPath Condition="'$(SPLibPath)' == '' And Exists('$(SPLibRelDir3)')">$(SPLibRelDir3)</SPLibPath>
    </PropertyGroup>
    <Copy SourceFiles="$(SPLibPath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'$(SPLibPath)' != ''" />
    <Warning Text="SP.dll not found (checked $(SPLibRelDir1), $(SPLibRelDir2), $(SPLibRelDir3)) - native library was not copied." Condition="'$(SPLibPath)' == ''" />
  </Target>

</Project>
